[Unit]
Description=CalSpread Go backend
Wants=network-online.target postgresql.service
After=network-online.target postgresql.service
StartLimitIntervalSec=60
StartLimitBurst=10

[Service]
Type=simple
User=calspread
Group=calspread
WorkingDirectory=/var/lib/calspread
StateDirectory=calspread
StateDirectoryMode=0750
Environment=DOTENV_CONFIG_PATH=/etc/calspread/calspread.env
Environment=HOST=127.0.0.1
Environment=PORT=3001
Environment=FRONTEND_URL=https://calspread.online
ExecStart=/opt/calspread/bin/calspread
Restart=always
RestartSec=5
KillSignal=SIGTERM
TimeoutStopSec=30
UMask=0027
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
RestrictSUIDSGID=true
CapabilityBoundingSet=
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6

[Install]
WantedBy=multi-user.target
