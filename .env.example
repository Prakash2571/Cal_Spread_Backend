# Copy to .env and fill in the broker/admin credentials.
# Local database: make db-start (PostgreSQL tools must be on PATH).
HOST=127.0.0.1
PORT=3001
TZ=Asia/Kolkata
FRONTEND_URL=http://127.0.0.1:5173
DATABASE_URL=postgres://calspread@127.0.0.1:55472/calspread?sslmode=disable

# Kite app credentials are required at startup. Configure the Kite app redirect:
# http://127.0.0.1:5173/zerodha/verify
KITE_API_KEY=your_api_key_here
KITE_API_SECRET=your_api_secret_here
ADMIN_SECRET=your_full_admin_secret_here
ACCESS_SECRET=your_trade_access_secret_here

# Optional credential-read endpoints; blank disables the corresponding routes.
# TOKEN_ROUTE_SECRET covers Kite/Dhan token reads and the protected rf read.
TOKEN_ROUTE_SECRET=
INTERNAL_TOKEN_SECRET=
SHUTDOWN_TIMEOUT_MS=12000

# Extra IST trading sessions on weekends, as comma-separated YYYY-MM-DD dates.
EXTRA_SESSION_DAYS=
HOURLY_BACKFILL_LOOKBACK_DAYS=7
DAY_REVIEW_TIME=16:30

# Fresh-start broker; a saved PostgreSQL broker selection takes precedence.
DEFAULT_BROKER=dhan

# Dhan market data. env_home performs the login; CalSpread fetches/saves
# the token like Live Index Algo. All service values belong only in this backend.
# Without the service settings, Broker -> Paste access token remains available.
DHAN_CLIENT_ID=
BROKER_LOGIN_URL=
BROKER_LOGIN_CF_CLIENT_ID=
BROKER_LOGIN_CF_CLIENT_SECRET=
DHAN_TOKEN_API_SEED=
# Every automatic request waits for this IST clock, including startup/recovery.
AUTO_LOGIN_TIME=08:30
DHAN_DATA_ENABLED=true
DHAN_HTTP_TIMEOUT_MS=8000
DHAN_MIN_INTERVAL_MS=120
DHAN_MAX_READ_ATTEMPTS=3

# Retained broker capability/status fields; these do not construct an order
# transport. This application records calendar trades and Synthetic paper trades.
DHAN_LIVE_TRADING_ENABLED=false
DHAN_STATIC_PUBLIC_IP=
DHAN_STATIC_IP_EXPECTED=false

# Shared option rate card. Legacy BOX_* names remain compatible; the Box feature
# itself is removed. Synthetic uses this card and the futures overrides below.
BOX_BROKERAGE_PER_ORDER=20
BOX_BROKERAGE_MAX_PCT=0
BOX_STT_SELL_PCT=0.15
BOX_STT_ROUND_NEAREST_RUPEE=true
BOX_EXCHANGE_TXN_PCT=0.03503
BOX_IPFT_PER_CRORE=50
BOX_IPFT_PCT=0
BOX_SEBI_PCT=0.0001
BOX_STAMP_DUTY_BUY_PCT=0.003
BOX_GST_PCT=18
BOX_STT_TYPE=stt
BOX_CHARGE_RATE_VERSION=zerodha-nse-options-2026-04-01

# Dedicated options-feed capacity. The legacy names describe Synthetic's extra
# budget; there is no Box scanner competing for it.
BOX_DEDICATED_MARKET_FEED=true
BOX_MAX_SUBSCRIBED_TOKENS=2200

SYNTH_STRIKE_LEVEL=3
SYNTH_PAPER_TRADING=true
SYNTH_MAX_OPEN_POSITIONS=0
SYNTH_MIN_EXPECTED_NET_PROFIT=500
SYNTH_SAFETY_BUFFER=100
SYNTH_EXPECTED_SLIPPAGE=0
SYNTH_INCLUDE_CARRY=true
SYNTH_DEFAULT_RF_PCT=0
SYNTH_MAX_TOKENS=750
SYNTH_SHARE_BOX_BUDGET=true
SYNTH_LANE_TOKEN_LIMIT=3000
SYNTH_QUOTE_MAX_AGE_MS=15000
SYNTH_FEED_MAX_AGE_MS=10000
SYNTH_SIGNAL_CONFIRMATIONS=2
SYNTH_REENTRY_COOLDOWN_MS=60000
SYNTH_FUT_STT_SELL_PCT=0.05
SYNTH_FUT_EXCHANGE_TXN_PCT=0.00173
SYNTH_FUT_IPFT_PER_CRORE=10
SYNTH_FUT_STAMP_DUTY_BUY_PCT=0.002
SYNTH_FUT_CHARGE_RATE_VERSION=nse-futures-2026-04-01

# Full-admin option valuation, off by default. Enabling it requires a verified
# expiry-time policy and a supplied curve or explicit flat-rate assumption.
FAIR_VALUE_ENABLED=false
FAIR_VALUE_DISABLED=false
FAIR_VALUE_CONFIG_JSON=
